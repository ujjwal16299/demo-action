{
  "name": "zv-gatsby",
  "root": "plugins/gatsby-source-card/",
  "tags": ["feature:"],
  "sourceRoot": "plugins/gatsby-source-card/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm install"
      }
    },
    "publish": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "plugins/gatsby-source-card/",
        "commands": ["npm version {args.version}", "npm publish"],
        "parallel": false
      }
    }
  }
}
